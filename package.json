  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "firebase-tools": "15.34.1",
    "jsdom": "30.1.3",
    "jsqr": "^1.4.0",
    "vite": "8.2.1"
  }
}
